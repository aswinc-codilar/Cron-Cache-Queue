# ------------------------------------------------------------
# Magento 2 (composer-based) .gitignore
# ------------------------------------------------------------

# Composer dependencies (installed via `composer install`)
/vendor/
/auth.json

# Environment-specific configuration (DB credentials, keys, etc.)
/app/etc/env.php
# Keep /app/etc/config.php committed — it holds module enable/disable state

# Generated code
/generated/*
!/generated/.htaccess

# Runtime files: cache, logs, sessions, page cache, etc.
/var/*
!/var/.htaccess

# Static content (regenerated by setup:static-content:deploy)
/pub/static/*
!/pub/static/.htaccess

# Uploaded / generated media (catalog images, captcha, imports, etc.)
/pub/media/*
!/pub/media/.htaccess

# Frontend tooling (copied from the .sample files locally)
/node_modules/
/package.json
/package-lock.json
/Gruntfile.js
/grunt-config.json
/dev/tools/grunt/configs/local-themes.js

# Test / tool caches
.phpunit.result.cache
.php-cs-fixer.cache
.php_cs.cache
/dev/tests/*/phpunit.xml
/dev/tests/integration/etc/install-config-mysql.php
/dev/tests/integration/tmp/*

# Local server config overrides
/nginx.conf
/.user.ini.local

# Environment files
.env
.env.*

# IDE / editor
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs & dumps
*.log
*.sql
*.sql.gz
*.tar.gz
*.zip
