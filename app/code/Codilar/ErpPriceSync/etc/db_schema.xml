<?xml version="1.0"?>
<!--
    Mock ERP price table. A row needs syncing when synced_at IS NULL OR updated_at > synced_at.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="erp_product_price" resource="default" engine="innodb" comment="Mock ERP Product Prices">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="decimal" name="price" scale="6" precision="20" unsigned="false" nullable="false"
                default="0" comment="Price"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <column xsi:type="timestamp" name="synced_at" nullable="true" comment="Last Synced Updated At"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last Sync Error"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ERP_PRODUCT_PRICE_SKU">
            <column name="sku"/>
        </constraint>
        <index referenceId="ERP_PRODUCT_PRICE_UPDATED_AT_SYNCED_AT" indexType="btree">
            <column name="updated_at"/>
            <column name="synced_at"/>
        </index>
    </table>
</schema>
