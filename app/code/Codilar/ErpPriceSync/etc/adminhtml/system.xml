<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="erp_price_sync" translate="label" type="text" sortOrder="900" showInDefault="1">
            <label>ERP Price Sync</label>
            <tab>catalog</tab>
            <resource>Codilar_ErpPriceSync::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cron_schedule" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Cron Schedule</label>
                    <comment>Cron expression. Default: * * * * * (every minute)</comment>
                    <backend_model>Codilar\ErpPriceSync\Model\Config\Backend\CronExpression</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="batch_size" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Batch Size</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
