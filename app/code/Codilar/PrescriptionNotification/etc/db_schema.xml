<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codilar_prescription_upload" resource="default" engine="innodb"
           comment="Prescription uploads and their notification state">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="prescription_file" length="255" nullable="false"
                comment="Stored file name, relative to var/prescription/{customer_id}/"/>
        <column xsi:type="varchar" name="original_name" length="255" nullable="true"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="pending"
                comment="pending | processing | sent | failed"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="text" name="error_message" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="notified_at" on_update="false" nullable="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <!-- One notification per customer/order/file: the basis of duplicate prevention -->
        <constraint xsi:type="unique" referenceId="CODILAR_PRESCRIPTION_UPLOAD_CUSTOMER_ORDER_FILE">
            <column name="customer_id"/>
            <column name="order_id"/>
            <column name="prescription_file"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CODILAR_PRESCRIPTION_UPLOAD_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="codilar_prescription_upload" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CODILAR_PRESCRIPTION_UPLOAD_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="codilar_prescription_upload" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="CODILAR_PRESCRIPTION_UPLOAD_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
