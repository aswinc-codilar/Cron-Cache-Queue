<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="prescription.upload"
                   template="Codilar_PrescriptionNotification::upload.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\PrescriptionNotification\ViewModel\PrescriptionUpload</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
